{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "static_collected" }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
