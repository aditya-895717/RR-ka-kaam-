SECRET_KEY=
DEBUG=True

# ── Database ────────────────────────────────────────────────────────────────
# Neon exposes TWO endpoints for the same database. They are NOT interchangeable
# and you need both. The only difference is '-pooler' in the hostname.
#
# DATABASE_URL — POOLED (host contains '-pooler')
#   Used by: the running app (Vercel serverless runtime).
#   Why: PgBouncer multiplexes many short-lived lambda connections.
#   Leave blank locally to fall back to SQLite.
#
#   postgresql://<user>:<pw>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# DIRECT_DATABASE_URL — DIRECT (same host, WITHOUT '-pooler')
#   Used by: migrate, makemigrations, test, loaddata, dumpdata, flush,
#            createsuperuser, seed_demo. settings.py swaps to this
#            automatically — no manual export needed.
#   Why: PgBouncer holds sessions open, which breaks schema and admin work:
#     migrate -> "server closed the connection unexpectedly"
#     test    -> 'database "test_neondb" is being accessed by other users'
#                (the blocking session is pgbouncer itself)
#
#   postgresql://<user>:<pw>@<project>.<region>.aws.neon.tech/<db>?sslmode=require
DIRECT_DATABASE_URL=

# ── Vercel host / CSRF ──────────────────────────────────────────────────────
# Comma-separated. '.vercel.app' matches every preview deployment as a suffix.
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# ── Missing-item sweep ──────────────────────────────────────────────────────
# Shared secret for /api/notifications/sweep/. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The endpoint returns 503 and refuses to run if this is unset.
SWEEP_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

BREVO_API_KEY=
DEFAULT_FROM_EMAIL=adityadubey22048@gmail.com
